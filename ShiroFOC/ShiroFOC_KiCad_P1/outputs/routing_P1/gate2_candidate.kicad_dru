(version 1)
(rule "Component pad drill separation" (condition "A.Type == 'Pad' || B.Type == 'Pad'") (constraint hole_to_hole (min 0.45mm)))
(rule "U901 thermal-via drill web" (condition "A.memberOfFootprint('U901') && B.memberOfFootprint('U901') && A.Pad_Number == '21' && B.Pad_Number == '21'") (constraint hole_to_hole (min 0.20mm)))
(rule "Q401 package internal copper" (condition "A.memberOfFootprint('Q401') && B.memberOfFootprint('Q401')") (constraint clearance (min 0.15mm)))
(rule "Q402 package internal copper" (condition "A.memberOfFootprint('Q402') && B.memberOfFootprint('Q402')") (constraint clearance (min 0.15mm)))
(rule "Q403 package internal copper" (condition "A.memberOfFootprint('Q403') && B.memberOfFootprint('Q403')") (constraint clearance (min 0.15mm)))
(rule "U301 package internal copper" (condition "A.memberOfFootprint('U301') && B.memberOfFootprint('U301')") (constraint clearance (min 0.15mm)))
(rule "U201 package internal copper" (condition "A.memberOfFootprint('U201') && B.memberOfFootprint('U201')") (constraint clearance (min 0.15mm)))
(rule "C415 package internal copper" (condition "A.memberOfFootprint('C415') && B.memberOfFootprint('C415')") (constraint clearance (min 0.15mm)))
(rule "C425 package internal copper" (condition "A.memberOfFootprint('C425') && B.memberOfFootprint('C425')") (constraint clearance (min 0.15mm)))
(rule "C435 package internal copper" (condition "A.memberOfFootprint('C435') && B.memberOfFootprint('C435')") (constraint clearance (min 0.15mm)))
(rule "Q401 local package bypass" (condition "(A.memberOfFootprint('Q401') && B.memberOfFootprint('C415')) || (A.memberOfFootprint('C415') && B.memberOfFootprint('Q401'))") (constraint clearance (min 0.20mm)))
(rule "Q402 local package bypass" (condition "(A.memberOfFootprint('Q402') && B.memberOfFootprint('C425')) || (A.memberOfFootprint('C425') && B.memberOfFootprint('Q402'))") (constraint clearance (min 0.20mm)))
(rule "Q403 local package bypass" (condition "(A.memberOfFootprint('Q403') && B.memberOfFootprint('C435')) || (A.memberOfFootprint('C435') && B.memberOfFootprint('Q403'))") (constraint clearance (min 0.20mm)))

# Local fanout: 0.15 mm remains the supplied 2 oz minimum.
(rule "U301_PACKAGE_ESCAPE: 2oz package escape" (condition "A.enclosedByArea('U301_PACKAGE_ESCAPE') && B.enclosedByArea('U301_PACKAGE_ESCAPE')") (constraint clearance (min 0.15mm)))
(rule "U301_BOOTSTRAP_ESCAPE: 2oz package escape" (condition "A.enclosedByArea('U301_BOOTSTRAP_ESCAPE') && B.enclosedByArea('U301_BOOTSTRAP_ESCAPE')") (constraint clearance (min 0.15mm)))
(rule "Q401_PACKAGE_ESCAPE: 2oz package escape" (condition "A.enclosedByArea('Q401_PACKAGE_ESCAPE') && B.enclosedByArea('Q401_PACKAGE_ESCAPE')") (constraint clearance (min 0.15mm)))
(rule "Q402_PACKAGE_ESCAPE: 2oz package escape" (condition "A.enclosedByArea('Q402_PACKAGE_ESCAPE') && B.enclosedByArea('Q402_PACKAGE_ESCAPE')") (constraint clearance (min 0.15mm)))
(rule "Q403_PACKAGE_ESCAPE: 2oz package escape" (condition "A.enclosedByArea('Q403_PACKAGE_ESCAPE') && B.enclosedByArea('Q403_PACKAGE_ESCAPE')") (constraint clearance (min 0.15mm)))
