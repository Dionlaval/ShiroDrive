Rbr4 sense 0 12.7k
Rbr5 cmd sense 1meg
.control
op
print v(out) v(pp) v(vmadc) v(ntcadc) v(fb10) v(fb5) v(sense)
alter Vsense 0.01767766953
op
print v(out) v(pp)
alter Vsense -0.01767766953
