  (instances(project "ShiroFOC_KiCad"(path "/a77d5bc4-a154-5c82-9669-89026d9e3c75/82bfdd37-9d82-5efa-8871-7778ab100779"(reference "TP1024")(unit 1)))))(text "10-PIN ARM CORTEX SWD + BOOT/POWER TEST ACCESS" (at 20.574 21.59 0)(effects (font (size 2.159 2.159)) (justify left bottom))(uuid "f11bdb4a-155f-5423-bdce-a75746d15a9e"))(text "The debugger must sense target 3V3 on VTREF; it must not source 3V3 into the board. PB3 is SPI3_SCK, therefore SWO is NC in Rev A." (at 20.574 297.18 0)(effects (font (size 1.524 1.524)) (justify left bottom))(uuid "b18c4015-3300-5afc-85b9-f20ea06e0020"))(text "BOOT0 shares PB8 with feedback I/H3. The mux is disabled during reset; the 1k button path permits deliberate ROM-boot entry without hard-shorting an active\nencoder output." (at 20.574 310.388 0)(effects (font (size 1.524 1.524)) (justify left bottom))(uuid "a7838bbf-0b34-5fff-ba01-78cc40ad1bb0"))(embedded_fonts no))
