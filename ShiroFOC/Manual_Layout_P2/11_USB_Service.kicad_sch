	(text "LAYOUT: route the USB pair continuously from J201 through U202 to U901; avoid stubs.\nC901/C902 belong at VREGIN; C903/C904 belong at VDD. Both pin groups use the same 3V3 rail."
		(exclude_from_sim no)
		(at 15.24 196.85 0)
		(effects
			(font
				(size 1.143 1.143))
			(justify left top))
		(uuid "6df23e37-b9af-558e-8097-3b239050e063"))
	(text "UART labels are named from the MCU point of view.\nTXD from U901 drives MCU RX. RTS/CTS are unused.\nSWD recovery and NRST are on the MCU sheet; BOOT0 is option-byte controlled."
		(exclude_from_sim no)
		(at 241.3 182.88 0)
		(effects
			(font
				(size 1.143 1.143))
			(justify left top))
		(uuid "93e161b9-61b3-50d7-987c-b7c7b40535c5"))
