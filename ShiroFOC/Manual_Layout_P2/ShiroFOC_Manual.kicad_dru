(version 1)
(rule "Component pad drill separation" (condition "A.Type == 'Pad' || B.Type == 'Pad'") (constraint hole_to_hole (min 0.45mm)))
(rule "U901 thermal-via drill web" (condition "A.memberOfFootprint('U901') && B.memberOfFootprint('U901') && A.Pad_Number == '21' && B.Pad_Number == '21'") (constraint hole_to_hole (min 0.20mm)))
(rule "U1 package internal copper" (condition "A.memberOfFootprint('U1') && B.memberOfFootprint('U1')") (constraint clearance (min 0.15mm)))
(rule "U2 package internal copper" (condition "A.memberOfFootprint('U2') && B.memberOfFootprint('U2')") (constraint clearance (min 0.15mm)))
(rule "U3 package internal copper" (condition "A.memberOfFootprint('U3') && B.memberOfFootprint('U3')") (constraint clearance (min 0.15mm)))
(rule "U4 package internal copper" (condition "A.memberOfFootprint('U4') && B.memberOfFootprint('U4')") (constraint clearance (min 0.15mm)))
(rule "U201 package internal copper" (condition "A.memberOfFootprint('U201') && B.memberOfFootprint('U201')") (constraint clearance (min 0.15mm)))
(rule "C1 package internal copper" (condition "A.memberOfFootprint('C1') && B.memberOfFootprint('C1')") (constraint clearance (min 0.15mm)))
(rule "C5 package internal copper" (condition "A.memberOfFootprint('C5') && B.memberOfFootprint('C5')") (constraint clearance (min 0.15mm)))
(rule "C9 package internal copper" (condition "A.memberOfFootprint('C9') && B.memberOfFootprint('C9')") (constraint clearance (min 0.15mm)))

(rule "U603 VSSOP internal pad spacing" (condition "A.memberOfFootprint('U603') && B.memberOfFootprint('U603')") (constraint clearance (min 0.15mm)))
