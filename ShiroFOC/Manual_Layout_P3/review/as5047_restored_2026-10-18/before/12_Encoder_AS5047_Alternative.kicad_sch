	(text "Reference circuit only: all rails and SPI labels are local ALT_ nets.\nNo electrical connection to the active board.\nTo restore: replace the active MA600A circuit with this circuit, reconnect\n3V3/GND and SPI3 signals, restore fit/board flags, and use SPI mode 1.\nFootprint and firmware must change together; these ICs are not drop-in compatible."
		(at 270 40.64 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left top))
		(uuid "01b615ea-be09-41dd-b7b5-592345b5f448"))
	(text "Original AS5047P wiring retained: 3.3 V operation, TEST grounded,\n100 nF + 1 uF decoupling and 10 kohm chip-select pull-up.\nA/B/index/UVW outputs remain unused."
		(at 20.32 157.48 0)
