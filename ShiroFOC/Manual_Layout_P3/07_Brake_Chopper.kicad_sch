	(text "U604 on External feedback supplies J601 + J502; 520mA nominal shared limit.\nPC1 / LPTIM1_OUT: 25kHz, non-inverting. R512 holds the buffer input LOW at reset.\nFirmware: keep PWM LOW on USB-only power; allow running only when motor VM is present.\n0% stops the specified Noctua fan. Two-wire fans on pins 1/2 run whenever 5V_SYS is powered."
		(at 198.12 260.35 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "8232852e-153a-4ee6-a89d-2145070b1ac5")
