	(text "BMI323: I2C ONLY\nCSB tied high; SDO low -> address 0x68.\nConfiguration and samples both use I2C.\n400 kHz; target 1 ms sample period.\nReads include two dummy bytes.\nMark sensor axes on the PCB."
		(exclude_from_sim no)
		(at 289.56 175.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1a75b2f5-0f0b-410d-afd6-383e0a92f9f0")
	)
	(text "AS5047P ABSOLUTE ANGLE\nSPI mode 1; start at about 5 MHz.\nRead angle + check parity/error flags.\nNo ABI count tracking for this sensor.\nAlign package center with shaft magnet."
		(exclude_from_sim no)
		(at 289.56 60.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4b61fb3f-cb8f-452d-a678-f057c4b2b652")
	)
	(text "POSITION + MOTION: dedicated encoder SPI3; independent IMU I2C2"
		(exclude_from_sim no)
		(at 15.24 20.32 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "a07a1ef0-dcc8-4d09-a4d9-3c74b8eb5a68")
	)
	(text "R313/R314 near MCU; R611 near encoder MISO. Retained local supply bypass.\nI2C pull-ups: 2.2k to 3V3. Target total bus capacitance <=150 pF at 400 kHz.\nKeep sensor wiring away from phase nodes and gate-drive loops."
		(exclude_from_sim no)
		(at 15.24 259.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f8416c08-6d42-4dd8-a8cf-a69517ed76b1")
	)
