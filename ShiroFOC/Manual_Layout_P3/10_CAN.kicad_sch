	(text "Both headers: 1 GND | 2 CANL | 3 CANH | 4 shield/drain. Pin 4 carries no supply."
		(exclude_from_sim no)
		(at 15.24 171.45 0)
		(effects
			(font
				(size 1.143 1.143)
			)
			(justify left top)
		)
		(uuid "2a815e40-12b3-520d-9739-e0991beaf721")
	)
	(text "10 V gate pull-up provides full enhancement at normal\nCAN levels. Intended bus range: 0 to 5 V vs local GND.\n30 V MOSFETs: this branch does not retain the\ntransceiver's full bus-fault / common-mode tolerance.\n\nQ802 exposed drain lands: D1 = pin 6, D2 = pin 3.\nProject footprints assigned; drain pads numbered 6 and 3."
		(exclude_from_sim no)
		(at 223.52 245.11 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "38281d47-bca6-5cb6-8854-e44a92d54f0b")
	)
	(text "Software-controlled termination below.\nEnable only at the two bus ends."
		(exclude_from_sim no)
		(at 190.5 62.23 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "578bbeb5-461a-5f45-87a5-f9471f8a3c22")
	)
	(text "SOFTWARE-CONTROLLED 120 OHM TERMINATION"
		(exclude_from_sim no)
		(at 20.32 193.04 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left top)
		)
		(uuid "67669748-b1b6-52f8-9d58-3efee37cc7c3")
	)
	(text "CONTROL (PC15, former status LED GPIO)\nHIGH: termination OFF; RGB indicator BLUE.\nLOW / reset Hi-Z: termination ON; indicator PURPLE.\nON requires the 10 V VCC rail.\n\nSet PC15 before releasing CAN_STB. Allow 1 ms\nfor gate settling; change only while CAN is idle.\nEnable only at the two physical bus ends.\nDo not blink this GPIO as a general status LED."
		(exclude_from_sim no)
		(at 223.52 208.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "99fb5924-684b-5e12-b722-2f3d94b236d2")
	)
	(text "CAN: controller -> transceiver -> protected daisy-chain bus"
		(exclude_from_sim no)
		(at 15.24 21.59 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "c06f5cef-84fa-56b4-b934-a4a002fd57cf")
	)
	(text "Sources joined; floating node"
		(exclude_from_sim no)
		(at 184.15 240.03 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "d68a00e7-ca56-56a4-ab7a-626a20cdfb8c")
	)
	(text "Reset state: STB high -> standby; TX high -> recessive.\nConfigure FDCAN before taking STB low.\nPlace D801 next to the connectors; route CANH/CANL together."
		(exclude_from_sim no)
		(at 15.24 140.97 0)
		(effects
			(font
				(size 1.143 1.143)
			)
			(justify left top)
		)
		(uuid "da77e4ef-3bc8-5844-b388-e9b74e2b75a6")
	)
